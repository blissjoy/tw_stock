FINMIND_API_TOKEN=your-finmind-api-token-here
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here
# 庫存清單/觀察清單雲端持久化用，跟上面主DB的Turso資料庫分開建立(選填，本機/桌面版
# 使用不需要設定這兩個，見README「Turso設定」章節)
TURSO_PORTFOLIO_DATABASE_URL=libsql://your-portfolio-database.turso.io
TURSO_PORTFOLIO_AUTH_TOKEN=your-turso-portfolio-auth-token-here
# web版「回補資料」分頁的存取密碼(選填)，按下「確認回補」時要求輸入這組字串才會
# 真的觸發寫入——這個功能會對主DB的Turso帳號做批次寫入，未設定時該分頁會顯示
# 「功能已停用」，不會讓任何人都能觸發。桌面版不使用這個變數。
BACKFILL_ACCESS_CODE=your-backfill-access-code-here
LINE_CHANNEL_ACCESS_TOKEN=your-line-messaging-api-channel-access-token-here
GMAIL_ADDRESS=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password-here
NOTIFY_EMAIL_TO=where-to-send-notifications@example.com
GOOGLE_OAUTH_CLIENT_SECRET_JSON={"installed":{"client_id":"...","project_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_secret":"...","redirect_uris":["http://localhost"]}}
GOOGLE_SHEET_ID=your-google-sheet-id-here
